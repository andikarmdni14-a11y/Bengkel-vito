# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env.

# Nomor WhatsApp bengkel. Format internasional: tanpa "+", tanpa "0" di depan, tanpa spasi.
VITE_WA_NUMBER=6281234567890

# Supabase: Project Settings -> API.
# Pakai "anon public" key (aman untuk browser, dilindungi RLS). JANGAN pernah memakai service_role key di sini.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
