# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env.

# Nomor WhatsApp bengkel. Format internasional: tanpa "+", tanpa "0" di depan, tanpa spasi.
VITE_WA_NUMBER=6281234567890

# Supabase: Project Settings -> API.
# Pakai "anon public" / "publishable" key (aman untuk browser, dilindungi RLS: lihat supabase/rls_hardening.sql).
# JANGAN pernah memakai service_role / sb_secret_ key di sini: variabel VITE_* ditanam ke bundel publik.
# Aplikasi menolak kunci rahasia (console error + `npm run build` dibatalkan).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
